<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WipacerERP - Panel de Administración</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-100 font-sans antialiased text-slate-800">

    <div class="flex h-screen overflow-hidden">

        <aside class="w-72 bg-slate-900 text-slate-300 hidden md:flex flex-col border-r border-slate-800">
            <div class="p-5 text-xl font-bold text-white tracking-wider flex items-center gap-3 border-b border-slate-800">
                <i class="fa-solid fa-cube text-blue-500 text-2xl"></i>
                <span>WipacerERP</span>
            </div>
            
            <nav class="flex-1 px-3 py-4 space-y-6 overflow-y-auto">
                <div>
                    <div class="px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">1. Administración (ADM)</div>
                    <div class="space-y-1">
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg bg-blue-600 text-white font-medium text-sm">
                            <i class="fa-solid fa-users-gear w-4 text-center"></i> ADM-01: Usuarios y Permisos
                        </a>
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-building w-4 text-center"></i> ADM-02: Datos Empresa
                        </a>
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-shield-halved w-4 text-center"></i> ADM-03: Auditoría y Logs
                        </a>
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-sliders w-4 text-center"></i> ADM-04: Configuración API / DIAN
                        </a>
                    </div>
                </div>

                <div>
                    <div class="px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">2. Contabilidad (CNT)</div>
                    <div class="space-y-1">
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-sitemap w-4 text-center"></i> CNT-01: Plan de Cuentas (PUC)
                        </a>
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-book w-4 text-center"></i> CNT-02: Comprobantes Diario
                        </a>
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-diagram-project w-4 text-center"></i> CNT-03: Centros de Costo
                        </a>
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-file-chart-column w-4 text-center"></i> CNT-04: Balances e Informes
                        </a>
                    </div>
                </div>

                <div>
                    <div class="px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">3. Doc. Electrónicos (DCE)</div>
                    <div class="space-y-1">
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-file-invoice w-4 text-center"></i> DCE-01: Facturación Venta
                        </a>
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-inbox w-4 text-center"></i> DCE-02: Recepción Compras
                        </a>
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-id-card w-4 text-center"></i> DCE-03: Nómina Electrónica
                        </a>
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-stamp w-4 text-center"></i> DCE-04: Resoluciones DIAN
                        </a>
                    </div>
                </div>

                <div>
                    <div class="px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">4. Inventarios (INV)</div>
                    <div class="space-y-1">
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-boxes-stacked w-4 text-center"></i> INV-01: Catálogo Ítems
                        </a>
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-warehouse w-4 text-center"></i> INV-02: Gestión Bodegas
                        </a>
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-right-left w-4 text-center"></i> INV-03: Entradas y Salidas
                        </a>
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-scale-balanced w-4 text-center"></i> INV-04: Ajustes y Valoración
                        </a>
                    </div>
                </div>

                <div>
                    <div class="px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">5. Tesorería (TES)</div>
                    <div class="space-y-1">
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-wallet w-4 text-center"></i> TES-01: Cuentas por Cobrar
                        </a>
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-receipt w-4 text-center"></i> TES-02: Cuentas por Pagar
                        </a>
                        <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-400 text-sm">
                            <i class="fa-solid fa-building-columns w-4 text-center"></i> TES-03: Bancos y Caja
                        </a>
                    </div>
                </div>
            </nav>

            <div class="p-4 border-t border-slate-800 text-xs text-slate-500">
                WipacerERP Admin Core v1.0
            </div>
        </aside>

        <main class="flex-1 flex flex-col overflow-y-auto">
            
            <header class="bg-white border-b border-slate-200 h-16 flex items-center justify-between px-8">
                <div class="flex items-center gap-3">
                    <span class="text-xs font-bold px-2.5 py-1 bg-slate-100 text-slate-600 rounded">Módulo Administrador</span>
                    <h1 class="text-lg font-semibold text-slate-800">Panel de Control General y Gestión de Submódulos</h1>
                </div>
                <div class="flex items-center gap-4">
                    <div class="text-right">
                        <div class="text-sm font-semibold text-slate-800">William Perez</div>
                        <div class="text-xs text-slate-500">Administrador de Sistema</div>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold shadow-sm">WP</div>
                </div>
            </header>

            <div class="p-8 space-y-8">
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
                        <div>
                            <div class="text-xs font-semibold text-slate-400 uppercase">ADM</div>
                            <div class="text-lg font-bold text-slate-800">4 Submódulos</div>
                            <div class="text-xs text-emerald-600 mt-1"><i class="fa-solid fa-circle-check"></i> Activos</div>
                        </div>
                        <div class="p-3 bg-blue-50 text-blue-600 rounded-lg"><i class="fa-solid fa-users-gear text-xl"></i></div>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
                        <div>
                            <div class="text-xs font-semibold text-slate-400 uppercase">CNT</div>
                            <div class="text-lg font-bold text-slate-800">4 Submódulos</div>
                            <div class="text-xs text-emerald-600 mt-1"><i class="fa-solid fa-circle-check"></i> En Línea</div>
                        </div>
                        <div class="p-3 bg-indigo-50 text-indigo-600 rounded-lg"><i class="fa-solid fa-calculator text-xl"></i></div>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
                        <div>
                            <div class="text-xs font-semibold text-slate-400 uppercase">DCE</div>
                            <div class="text-lg font-bold text-slate-800">4 Submódulos</div>
                            <div class="text-xs text-emerald-600 mt-1"><i class="fa-solid fa-plug text-xs"></i> DIAN OK</div>
                        </div>
                        <div class="p-3 bg-emerald-50 text-emerald-600 rounded-lg"><i class="fa-solid fa-file-invoice text-xl"></i></div>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
                        <div>
                            <div class="text-xs font-semibold text-slate-400 uppercase">INV</div>
                            <div class="text-lg font-bold text-slate-800">4 Submódulos</div>
                            <div class="text-xs text-emerald-600 mt-1"><i class="fa-solid fa-cubes text-xs"></i> 2 Bodegas</div>
                        </div>
                        <div class="p-3 bg-amber-50 text-amber-600 rounded-lg"><i class="fa-solid fa-boxes-stacked text-xl"></i></div>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
                        <div>
                            <div class="text-xs font-semibold text-slate-400 uppercase">TES</div>
                            <div class="text-lg font-bold text-slate-800">3 Submódulos</div>
                            <div class="text-xs text-emerald-600 mt-1"><i class="fa-solid fa-check text-xs"></i> Sincronizado</div>
                        </div>
                        <div class="p-3 bg-purple-50 text-purple-600 rounded-lg"><i class="fa-solid fa-wallet text-xl"></i></div>
                    </div>
                </div>

                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="p-6 border-b border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
                        <div>
                            <h2 class="text-base font-bold text-slate-800">Vista de Administración: Control de Usuarios (Submódulo ADM-01)</h2>
                            <p class="text-xs text-slate-500 mt-0.5">Asignación de roles, estado de cuenta y permisos por módulo del sistema.</p>
                        </div>
                        <button class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg flex items-center gap-2 transition shadow-sm">
                            <i class="fa-solid fa-plus"></i> Crear Nuevo Usuario
                        </button>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-xs font-semibold uppercase tracking-wider border-b border-slate-200">
                                    <th class="py-3 px-6">Usuario</th>
                                    <th class="py-3 px-6">Rol Asignado</th>
                                    <th class="py-3 px-6">Módulos Permitidos</th>
                                    <th class="py-3 px-6">Último Acceso</th>
                                    <th class="py-3 px-6">Estado</th>
                                    <th class="py-3 px-6 text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-200 text-sm text-slate-700">
                                <tr class="hover:bg-slate-50">
                                    <td class="py-4 px-6 font-medium text-slate-900 flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-slate-800 text-white flex items-center justify-center font-bold text-xs">WP</div>
                                        <div>
                                            <div class="font-semibold">William Perez</div>
                                            <div class="text-xs text-slate-400">william@wipacerp.com</div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-6"><span class="bg-purple-100 text-purple-800 text-xs px-2.5 py-1 rounded-full font-semibold">Super Admin</span></td>
                                    <td class="py-4 px-6 text-xs text-slate-500">ADM, CNT, DCE, INV, TES (Todos)</td>
                                    <td class="py-4 px-6 text-xs">Hace 2 minutos</td>
                                    <td class="py-4 px-6"><span class="bg-emerald-100 text-emerald-800 text-xs px-2.5 py-1 rounded-full font-semibold">Activo</span></td>
                                    <td class="py-4 px-6 text-center">
                                        <button class="p-1.5 text-slate-400 hover:text-blue-600"><i class="fa-solid fa-pen-to-square"></i></button>
                                        <button class="p-1.5 text-slate-400 hover:text-red-600"><i class="fa-solid fa-lock"></i></button>
                                    </td>
                                </tr>
                                <tr class="hover:bg-slate-50">
                                    <td class="py-4 px-6 font-medium text-slate-900 flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-xs">AC</div>
                                        <div>
                                            <div class="font-semibold">Auxiliar Contable</div>
                                            <div class="text-xs text-slate-400">contabilidad@wipacerp.com</div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-6"><span class="bg-blue-100 text-blue-800 text-xs px-2.5 py-1 rounded-full font-semibold">Contador</span></td>
                                    <td class="py-4 px-6 text-xs text-slate-500">CNT, DCE, TES</td>
                                    <td class="py-4 px-6 text-xs">Hoy 09:15 AM</td>
                                    <td class="py-4 px-6"><span class="bg-emerald-100 text-emerald-800 text-xs px-2.5 py-1 rounded-full font-semibold">Activo</span></td>
                                    <td class="py-4 px-6 text-center">
                                        <button class="p-1.5 text-slate-400 hover:text-blue-600"><i class="fa-solid fa-pen-to-square"></i></button>
                                        <button class="p-1.5 text-slate-400 hover:text-red-600"><i class="fa-solid fa-lock"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </main>

    </div>

</body>
</html>
